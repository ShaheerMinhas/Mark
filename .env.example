# Database (defaults to local SQLite data/mark.db when unset)
# DATABASE_URL=postgresql://user:pass@localhost:5432/mark
MARK_SECRET_KEY=change-me-in-production-use-long-random-string

# Worker & concurrency controls
MARK_INLINE_WORKER=true
MARK_WORKER_CONCURRENCY=3
SEARCH_MAX_CONCURRENCY=12
ENRICHMENT_MAX_CONCURRENCY=16
CRAWLER_MAX_CONCURRENCY=5
BATCH_SIZE=250
MARK_ENGINE_REPLICAS=4
MARK_SEARCH_CACHE_HOURS=24

# Email enrichment (optional — only used when the matching key is set)
EMAIL_PROVIDER=hunter,tomba,leadmagic,prospeo,findymail
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET=
LEADMAGIC_API_KEY=
PROSPEO_API_KEY=
FINDYMAIL_API_KEY=
EMAIL_CACHE_DAYS=30
